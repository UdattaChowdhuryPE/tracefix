# Anthropic API key (required — used by gitclaw agent)
ANTHROPIC_API_KEY=sk-ant-...

# GitHub PAT (optional — needed to open PRs)
GITHUB_TOKEN=ghp_...

# Internal API secret (required in production — used to authenticate internal endpoints)
INTERNAL_API_SECRET=<random-secret-at-least-32-chars>

# Session database path (optional — defaults to backend/tracefix_sessions.db)
SESSIONS_DB_PATH=tracefix_sessions.db

# Agent timeout in seconds (optional — defaults to 660)
AGENT_TIMEOUT_SECONDS=660

# TraceFix backend URL (used by request_human_review.sh to call back)
TRACEFIX_BACKEND_URL=http://localhost:8000

# Frontend-to-backend URL (used by Next.js frontend to connect to backend API/WebSocket)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Allowed CORS origins (comma-separated, used by FastAPI backend)
CORS_ALLOW_ORIGINS=http://localhost:3000
